{
  "name": "poke-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "API de equipos Pokemon para la app PokeAPI (backend sujeto a pruebas de seguridad)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "lint": "eslint src tests",
    "sast": "semgrep --config ../security/semgrep --error --json --output ../security/results/sast-semgrep.json src || true",
    "sca": "npm audit --json > ../security/results/sca-npm-audit.json || true",
    "dast": "node ../security/dast-scan.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "express": "^4.21.0",
    "jsonwebtoken": "8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
